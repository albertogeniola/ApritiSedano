<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4.5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Backup e ripristino"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_backup_device_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_shelly_cloud"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="0 dispositivi"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="Tocca l'operazione che desideri eseguire"
            android:textColor="@color/sheet_text_secondary"
            android:textSize="13.5sp" />

        <!-- Opzione 1: Esporta -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_backup_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="18dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/option_card_press"
            app:cardBackgroundColor="@color/sheet_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:rippleColor="@color/option_ripple_green"
            app:strokeColor="@color/option_stroke_green"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_green"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/option_accent_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Esporta backup su file"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Salva tutti i seed e le impostazioni"
                        android:textColor="@color/sheet_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tocca per creare il file di export"
                        android:textColor="@color/option_accent_green"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_cta_circle_green"
                    android:contentDescription="@null"
                    android:elevation="2dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_forward" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Opzione 2: Importa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_backup_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/option_card_press"
            app:cardBackgroundColor="@color/sheet_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:rippleColor="@color/option_ripple_blue"
            app:strokeColor="@color/option_stroke_blue"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_blue"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_upload"
                    app:tint="@color/option_accent_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Importa backup da file"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ripristina un file esportato in precedenza"
                        android:textColor="@color/sheet_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tocca per selezionare il file"
                        android:textColor="@color/option_accent_blue"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_cta_circle_blue"
                    android:contentDescription="@null"
                    android:elevation="2dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_forward" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_backup_sheet"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Chiudi"
            android:textAllCaps="false"
            android:textColor="@color/sheet_cancel_btn_text"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/sheet_cancel_btn_bg"
            app:cornerRadius="14dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
