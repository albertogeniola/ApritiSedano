<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Importa da QR Code"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="Come desideri acquisire il codice di backup?"
        android:textColor="@color/sheet_text_secondary"
        android:textSize="13.5sp" />

    <!-- Opzione 1: Scansione con fotocamera -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_qr_scan_camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/option_card_press"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:rippleColor="@color/option_ripple_blue"
        app:strokeColor="@color/option_stroke_blue"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_blue"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_qr_code_scanner"
                app:tint="@color/option_accent_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inquadra con fotocamera"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Scansiona il QR Code mostrato su un altro schermo"
                    android:textColor="@color/sheet_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/sheet_text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Opzione 2: Carica da immagine / galleria -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_qr_pick_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/option_card_press"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:rippleColor="@color/option_ripple_green"
        app:strokeColor="@color/option_stroke_green"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_green"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_image"
                app:tint="@color/option_accent_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scegli da immagine / Galleria"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Seleziona uno screenshot o foto del QR salvata"
                    android:textColor="@color/sheet_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/sheet_text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_qr_sheet"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Annulla"
        android:textAllCaps="false"
        android:textColor="@color/sheet_cancel_btn_text"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:backgroundTint="@color/sheet_cancel_btn_bg"
        app:cornerRadius="14dp" />

</LinearLayout>
