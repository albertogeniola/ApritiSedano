<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_green"
            android:padding="9dp"
            android:src="@drawable/ic_gate"
            app:tint="#2E7D32" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_shelly_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancello"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_shelly_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shelly Cloud"
                android:textColor="#5F6368"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sheet_shelly_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_shelly_cloud"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="ARMATO"
            android:textColor="#2E7D32"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#ECEFF1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action_shelly_edit"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="Configura dispositivo e auto-apertura"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14.5sp"
        app:icon="@android:drawable/ic_menu_manage"
        app:iconPadding="14dp"
        app:iconTint="#5F6368" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action_shelly_check"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="Verifica stato Cloud"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14.5sp"
        app:icon="@drawable/ic_cloud"
        app:iconPadding="14dp"
        app:iconTint="#1565C0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action_shelly_test_notif"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="Invia notifica di test (Android Auto)"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14.5sp"
        app:icon="@drawable/ic_car"
        app:iconPadding="14dp"
        app:iconTint="#2E7D32" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action_shelly_toggle_arm"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="Arma rientro manualmente"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14.5sp"
        android:visibility="gone"
        app:icon="@drawable/ic_my_location"
        app:iconPadding="14dp"
        app:iconTint="#EF6C00" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action_shelly_nfc"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="Scrivi Tag NFC"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14.5sp"
        app:icon="@android:drawable/ic_menu_share"
        app:iconPadding="14dp"
        app:iconTint="#5F6368" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#ECEFF1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action_shelly_delete"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="Elimina dispositivo"
        android:textAllCaps="false"
        android:textColor="#C62828"
        android:textSize="14.5sp"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconPadding="14dp"
        app:iconTint="#C62828" />

</LinearLayout>
